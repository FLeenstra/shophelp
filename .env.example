# Copy to .env and fill in. docker compose reads .env automatically.

# Enables the embedded Google map in the frontend. Without it, the app still
# works (route list + "Open in Google Maps" button); the embedded map shows a
# placeholder. Create a key in Google Cloud with the "Maps JavaScript API"
# enabled, and restrict it to your domain/HTTP referrers.
GOOGLE_MAPS_API_KEY=
